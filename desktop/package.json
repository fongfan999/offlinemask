{
  "name": "offlinemask-desktop",
  "private": true,
  "version": "2.0.1",
  "description": "Offline desktop workspace for reviewing sensitive data",
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": "^22.12.0 || >=24.0.0",
    "pnpm": "11.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/prepare-runtime.mjs && pnpm typecheck && vite build && node scripts/prepare-assets.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "vue-tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "check:native": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check && cargo clippy --manifest-path src-tauri/Cargo.toml --locked --workspace --all-targets -- -D warnings",
    "test:native": "cargo test --manifest-path src-tauri/Cargo.toml --locked --workspace",
    "desktop:dev": "tauri dev",
    "desktop:build": "node scripts/build-desktop.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:models": "node scripts/check-pack.mjs",
    "pack:prepare": "node scripts/prepare-pack.mjs",
    "models:download": "node scripts/prepare-models.mjs --download",
    "models:check": "node scripts/prepare-models.mjs",
    "test:models:legacy": "pnpm models:check && node scripts/evaluate-model.mjs",
    "compare:models": "pnpm models:check && node scripts/compare-models.mjs",
    "desktop:build:native": "node scripts/build-native-desktop.mjs",
    "desktop:dev:native": "node scripts/dev-native-desktop.mjs"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans": "5.3.0",
    "@huggingface/transformers": "4.2.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-autostart": "2.7.0",
    "@tauri-apps/plugin-clipboard-manager": "2.5.0",
    "@tauri-apps/plugin-dialog": "2.7.3",
    "@tauri-apps/plugin-fs": "2.5.2",
    "@tauri-apps/plugin-global-shortcut": "2.4.1",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "exceljs": "4.4.0",
    "ipaddr.js": "2.5.0",
    "jszip": "3.10.2",
    "libphonenumber-js": "1.13.12",
    "linkify-it": "6.1.0",
    "openmed": "2.3.0",
    "papaparse": "5.7.0",
    "vue": "^3.5.13",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3",
    "@types/node": "^24",
    "@types/papaparse": "5.5.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vue-tsc": "^3.3.5"
  }
}
