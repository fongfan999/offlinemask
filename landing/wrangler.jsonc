{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "offlinemask-landing",
  "compatibility_date": "2026-10-01",
  // Answers /latest.json and /download/<platform> from the newest GitHub release (decision
  // 0140); every other path is a static asset and never runs it.
  "main": "./worker.js",
  // offlinemask.com is registered at Cloudflare (20 October 2026). A deploy binds the
  // Worker to the apex and www as custom domains and creates their DNS records.
  "routes": [
    { "pattern": "offlinemask.com", "custom_domain": true },
    { "pattern": "www.offlinemask.com", "custom_domain": true },
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": ["/latest.json", "/download/*"],
  },
  "observability": { "enabled": false },
  // One row per download: platform and country, no address or identifier (decision 0144).
  "analytics_engine_datasets": [{ "binding": "DOWNLOADS", "dataset": "offlinemask_downloads" }],
}
