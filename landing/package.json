{
  "name": "offlinemask-landing",
  "private": true,
  "type": "module",
  "description": "Standalone product landing page for Cloudflare Workers static assets",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
